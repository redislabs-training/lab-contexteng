---
import { config } from "../../lab-config";
const heroData = config.hero;

---

<style>
    .container {
        display: flex;
        min-height: 100vh;
        align-items: center;
        justify-content: center;
        background-color: #FFFFFF;
    }

    .logo {
        padding-bottom: 4%;
    }

    .content-wrapper {
        max-width: 48rem;
        text-align: center;
        padding: 0 1rem;
    }

    .badge {
        display: inline-block;
        margin-bottom: 2rem;
        border-radius: 9999px;
        background-color: rgba(229, 62, 62, 0.1);
        padding: 0.5rem 1rem;
    }

    .badge-text {
        font-size: 0.875rem;
        font-weight: 600;
        color: #FF4438;
    }

    .title,
    #tagline {
        font-family: "Space Grotesk", sans-serif;
        margin-bottom: 1.5rem;
        font-size: 3rem;
        font-weight: 500;
        letter-spacing: -0.025em;
        color: #091A23 !important;
        line-height: 1.1;
    }

    .title-highlight {
        display: block;
        color: #FF4438;
    }

    .subtitle {
        font-family: "Space Grotesk", sans-serif;
        margin-bottom: 3rem;
        font-size: 1.125rem;
        font-weight: 400;
        color: #091A23;
    }

    .cta-button.hero-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        height: 3.5rem;
        padding: 0 2.5rem;
        border-radius: 0.5rem;
        background-color: #FF4438 !important;
        border: 1px solid #D1281E !important;
        color: white;
        font-size: 1rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cta-button.hero-cta:hover {
        background-color: #FF4438 !important;
        border-color: #E4291E !important;
        transform: none !important;
    }

    .arrow-icon {
        width: 1.25rem;
        height: 1.25rem;
        transition: transform 0.3s ease;
    }

    .cta-button:hover .arrow-icon {
        transform: translateX(0.25rem);
    }

    @media (min-width: 640px) {
        .title {
            font-size: 3.75rem;
        }
    }

    @media (min-width: 1024px) {
        .title {
            font-size: 4.5rem;
        }
        .subtitle {
            font-size: 1.25rem;
        }
    }

    /* Dark mode support */
    @media (prefers-color-scheme: dark) {
        .container {
            background-color: #091A23;
        }

        .title,
        #tagline {
            color: #ffffff !important;
        }

        .subtitle {
            color: #ffffff;
        }

        .cta-button.hero-cta {
            background-color: #351D22 !important;
            border-color: #FF4438 !important;
        }

        .cta-button.hero-cta:hover {
            background-color: #8A221C !important;
            border-color: #EB352A !important;
        }
    }
</style>

<div class="container">
    <div class="content-wrapper">
        <!-- Logo/Badge -->
        <div class="logo">
            <img
                src="doc/assets/redis_logo.png"
                alt="Redis University Lab"
                width="23%"
            />
        </div>

        <!-- Main Title -->
        <h1 id="tagline" class="title">{heroData.tagline}</h1>

        <!-- Subtitle -->
        <p class="subtitle">{heroData.subtitle}</p>

        <!-- Test LLM Button -->
        <button id="test-btn" class="cta-button hero-cta">
            Test LLM Connection
        </button>
        <div id="result" style="margin-top: 2rem; padding: 1rem; white-space: pre-wrap; text-align: left; max-width: 600px; margin-left: auto; margin-right: auto;"></div>
    </div>
</div>

<script>
document.getElementById('test-btn')?.addEventListener('click', async function() {
  const btn = document.getElementById('test-btn') as HTMLButtonElement;
  const result = document.getElementById('result')!;
  
  btn.disabled = true;
  btn.textContent = 'Testing...';
  result.innerHTML = '';
  
  try {
    const response = await fetch('http://localhost:4000/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'gpt-4o-mini',
        messages: [{ role: 'user', content: 'Say "Hello! Connection successful." in exactly those words.' }],
        max_tokens: 50
      })
    });
    
    const data = await response.json();
    
    if (data.choices && data.choices[0]) {
      const msg = data.choices[0].message.content;
      result.innerHTML = '<div style="color: #10a37f; font-size: 1.5rem;">✅ Success!</div><div style="margin-top: 1rem; background: #1a1a1a; padding: 1rem; border-radius: 8px; color: #fff;"><strong>Model:</strong> ' + data.model + '<br/><strong>Response:</strong> ' + msg + '</div>';
    } else if (data.error) {
      result.innerHTML = '<div style="color: #ef4444;">❌ Error: ' + (data.error.message || JSON.stringify(data.error)) + '</div>';
    } else {
      result.innerHTML = '<div style="color: #ef4444;">❌ Unexpected response: ' + JSON.stringify(data) + '</div>';
    }
  } catch (err: any) {
    result.innerHTML = '<div style="color: #ef4444;">❌ Request failed: ' + err.message + '</div>';
  }
  
  btn.disabled = false;
  btn.textContent = 'Test LLM Connection';
});
</script>
